{
  "name": "dsh-pele-mermaid",
  "version": "0.1.1",
  "description": "DeepSeek Harness web client plugin: render explicit Mermaid fences with Pele — synchronous, dependency-free, with automatic image loading disabled and CSS-variable theming. Disabled or absent, DSH behaves exactly as shipped.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/KNOWN-LIMITATIONS.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mermaid",
    "pele",
    "diagram",
    "web-client"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "node scripts/verify-bundle.mjs",
    "verify:host": "node scripts/verify-host.mjs",
    "verify:visual": "node scripts/verify-visual.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "pele": "^1.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
